# AWS Deployment environment
AWS_REGION=ap-southeast-1
# Leave empty to use your AWS profile
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Database Settings
SETTING_TABLE=aibox_setting
SESSION_TABLE=aibox_session
RETENTION_DAYS=30

# Server Settings
SERVER_HOST=localhost
SERVER_PORT=8080
DEBUG=True

# Security Settings
# Comma-separated user `sub`s allowed to change MCP servers (find yours at /api/auth/me).
# Leave empty and adding stdio MCP servers (which run commands on the host) is refused;
# http/sse servers remain open to any logged-in user.
ADMIN_SUBS=
# Max size of a single uploaded file in MB (frontend enforces 20MB too).
MAX_UPLOAD_MB=20

# CORS Settings
# Comma-separated list of allowed origins. Wildcard '*' is rejected because
# requests carry the SSO cookie (credentialed requests).
CORS_ORIGINS=http://localhost:8080
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# LLM Provider Settings
# Bedrock
BEDROCK_REGION=us-west-2
# Gemini
GEMINI_SECRET_ID=gemini_api_key
# OpenAI
OPENAI_SECRET_ID=openai_api_key

# Myners SSO, the only login: the app validates the SSO cookie against <SSO_AUTH_ORIGIN>/introspect.
# The frontend's VITE_SSO_AUTH_ORIGIN (frontend/.env) must match. Locally, a browser sends the .myners.net
# cookie only to a *.myners.net host: map e.g. aibox-dev.myners.net to 127.0.0.1 in /etc/hosts.
SSO_AUTH_ORIGIN=https://auth.myners.net
SSO_COOKIE_NAME=myners_sid
SSO_CACHE_TTL=30
SSO_STALE_GRACE_TTL=60
SSO_REQUEST_TIMEOUT=5

# Max model calls per user message in Chat/agents; stops a model stuck re-calling a tool (default 90)
# AGENT_MAX_CYCLES=90

# Web search for the search_internet tool (Exa). Without it the free DuckDuckGo scraper is used, which finds
# nothing for most queries from a cloud server.
# EXA_API_KEY=
